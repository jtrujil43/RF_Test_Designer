1630 WL=MF:WH=2*(Q-MF)
1640 WC=WL:GOSUB 9400:ZL=ZC
1650 WC=WH:GOSUB 9400:ZH=ZC
1660 PF=1
1670 IF ZL<50 OR ZH>50 THEN PF=0
1680 IF PF=0 THEN 1760
1690 FOR K=1 TO 36
1700 WC=(WL+WH)/2:GOSUB 9400
1710 IF ZC>50 THEN WL=WC
1720 IF ZC<=50 THEN WH=WC
1730 NEXT K
1740 WC=(WL+WH)/2
1750 GOTO 1780
1760 WC=WL:IF ABS(ZH-50)<ABS(ZL-50) THEN WC=WH
1770 REM PF=0 REPORTS CLOSEST LEGAL NECK, NOT 50 OHM
1780 WN=WC:SN=Q-WN/2:GOSUB 9400
1790 ZN=ZC:EN=EC:RETURN
