9000 REM HJ QUASI-STATIC MODEL, INPUT U=W/H
9010 TT=MT/H:D1=0
9020 IF TT=0 THEN 9050
9030 AA=EXP(-2*SQR(6.517*U)):AB=(1-AA)/(1+AA)
9040 D1=TT/PI*LOG(1+4*EXP(1)*AB*AB/TT)
9050 AA=SQR(ER-1):AB=2/(EXP(AA)+EXP(-AA))
9060 D2=.5*D1*(1+AB):U1=U+D1:UR=U+D2
9070 UX=UR:GOSUB 9200:ZR=ZV
9080 UX=U1:GOSUB 9200:Z1=ZV
9090 AA=1+LOG((UR^4+(UR/52)^2)/(UR^4+.432))/49
9100 AA=AA+LOG(1+(UR/18.1)^3)/18.7
9110 AB=.564*((ER-.9)/(ER+3))^.053
9120 E0=(ER+1)/2+(ER-1)/2*(1+10/UR)^(-AA*AB)
9130 ZZ=ZR/SQR(E0):EX=E0*(Z1/ZR)^2
9140 RETURN
9200 REM VACUUM MICROSTRIP Z, INPUT UX
9210 AB=(30.666/UX)^.7528:AC=0
9212 IF AB<80 THEN AC=EXP(-AB)
9214 AA=6+(2*PI-6)*AC
9220 ZV=60*LOG(AA/UX+SQR(1+(2/UX)^2))
9230 RETURN
9400 REM GROUNDED CPW / FINITE H / ZERO T
9410 REM INPUT WC AND FIXED GROUND INNER EDGE Q
9420 KK=WC/(2*Q):GOSUB 9700:K1=KR
9430 AA=PI*WC/(4*H):AB=PI*2*Q/(4*H)
9440 VA=0:VB=0
9450 IF AA<40 THEN VA=EXP(-2*AA)
9460 IF AB<40 THEN VB=EXP(-2*AB)
9470 IF AA>4 THEN 9520
9480 KK=(1-VA)/(1+VA)*(1+VB)/(1-VB)
9490 IF KK>.9999999 THEN KK=.9999999
9500 GOSUB 9700:K3=KR:GOTO 9600
9520 REM STABLE K'/LOG ASYMPTOTE FOR THIN H
9530 VD=0:VS=0:AC=AB-AA
9540 IF AC<40 THEN VD=EXP(-2*AC)
9550 IF AA+AB<40 THEN VS=EXP(-2*(AA+AB))
9560 KP=LOG(2)-AA+.5*LOG(1-VD)+.5*LOG(1-VS)
9570 KP=KP-LOG(1+VA)-LOG(1-VB)
9580 KD=0:IF KP>-40 THEN KD=EXP(2*KP)
9585 K3=2/PI*(LOG(4)-KP-KD/4-13*KD*KD/128)
9600 EC=1+(ER-1)*K3/(K1+K3)
9610 ZC=60*PI/(SQR(EC)*(K1+K3))
9620 RETURN
9700 REM K(KK)/K'(KK) VIA ARITHMETIC-GEOMETRIC MEAN
9710 AG=1:BG=SQR(1-KK*KK)
9720 FOR J=1 TO 9
9730 CG=(AG+BG)/2:BG=SQR(AG*BG):AG=CG
9740 NEXT J
9750 A1=AG:AG=1:BG=KK
9760 FOR J=1 TO 9
9770 CG=(AG+BG)/2:BG=SQR(AG*BG):AG=CG
9780 NEXT J
9790 KR=AG/A1:RETURN
