1200 REM BISECT WIDTH/H WITHIN HJ MODEL RANGE
1210 UL=.01:UH=100
1220 FOR K=1 TO 36
1230 U=(UL+UH)/2:GOSUB 9000
1240 IF ZZ>50 THEN UL=U
1250 IF ZZ<=50 THEN UH=U
1260 NEXT K
1270 U=(UL+UH)/2:GOSUB 9000
1280 W=U*H:EE=EX:ZM=ZZ
1290 RETURN
1300 REM LENGTH AND MINIMUM LOCAL BEND RADIUS
1310 CP=0:BD=1E20:DT=2*PI/720
1320 FOR I=0 TO 719
1330 A=(I+.5)*DT
1340 B=1+AM*COS(N*A)
1350 D=-AM*N*SIN(N*A)
1360 E=-AM*N*N*COS(N*A)
1370 CP=CP+SQR(B*B+D*D)*DT
1380 F=ABS(B*B+2*D*D-B*E)
1390 IF F<1E-12 THEN 1420
1400 V=(B*B+D*D)^1.5/F
1410 IF V<BD THEN BD=V
1420 NEXT I
1430 LL=C0/(F0*SQR(EE))
1440 R=LL/CP:RO=R*(1+AM):RI=R*(1-AM)
1450 MC=R*BD:OD=2*RO+W
1460 NF=INT(FA/F0):IF NF<1 THEN NF=1
1470 IF NF*F0<FA-1E-7*F0 THEN NF=NF+1
1480 NZ=INT(FB/F0+1E-7):NM=NZ-NF+1
1490 IF NM<0 THEN NM=0
1500 RETURN
