1820 IF FL<2*PP THEN FL=2*PP
1830 TL=5*PP:IF TL<3*H THEN TL=3*H
1840 IF TL<3*ABS(W-WN) THEN TL=3*ABS(W-WN)
1850 NL=2*PP:IF NL<PL THEN NL=PL
1860 PT=PP:IF PT<.1 THEN PT=.1
1870 QF=W/2+3*H:IF QF<Q THEN QF=Q
1880 GW=3*H:IF GW<2*PP THEN GW=2*PP
1890 WG=QF+GW
1900 X0=RO+W/2+GP:X1=X0+FL:X2=X1+TL
