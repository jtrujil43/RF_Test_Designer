10 REM MATRIX LIBRARY - C64 BASIC V2
20 REM A,B:INPUT C:RESULT D:WORKSPACE
30 DIM A(10,10),B(10,10),C(10,10),D(10,20)
40 M=0:N=0:P=0:Q=0:ZP=3.141592654
100 PRINT CHR$(147)
110 PRINT "MATRIX LIBRARY - C64"
120 PRINT " 1 INPUT A         14 INVERSE A"
130 PRINT " 2 INPUT B         15 GAUSS-JORDAN"
140 PRINT " 3 SHOW A          16 SOLVE AX=B"
150 PRINT " 4 SHOW B          17 MATRIX POWER"
160 PRINT " 5 A+B             18 COPY A TO C"
170 PRINT " 6 A-B             19 RREF"
180 PRINT " 7 A*B             20 TRACE"
190 PRINT " 8 TRANSPOSE A     21 RANK"
200 PRINT " 9 IDENTITY        22 LU DECOMP"
210 PRINT "10 DETERMINANT     23 EIGEN 2X2"
220 PRINT "11 SCALAR*A        24 EIGEN 3X3"
230 PRINT "12 SWAP ROWS       25 EXIT"
240 PRINT "13 SWAP COLUMNS"
250 INPUT "CHOICE";CH
260 IF CH=25 THEN END
270 IF CH<1 OR CH>24 OR CH<>INT(CH) THEN 250
280 PRINT CHR$(147)
290 IF CH>12 THEN 320
300 ON CH GOSUB 2000,3000,4000,5000,6000,7000
310 IF CH>6 THEN ON CH-6 GOSUB 8000,9000,10000,11000,12000,13000
315 GOTO 350
320 ON CH-12 GOSUB 14000,15000,16000,17000,18000,19000
330 IF CH>18 THEN ON CH-18 GOSUB 20000,21000,22000,23000,24000,25000
350 GOSUB 1000:GOTO 100
1000 PRINT:INPUT "RETURN TO CONTINUE";K$:RETURN
1100 GF=0
1110 IF M=0 OR N=0 THEN PRINT "A IS EMPTY":RETURN
1120 GF=1:RETURN
1150 GOSUB 1100:IF GF=0 THEN RETURN
1160 IF M<>N THEN GF=0:PRINT "A MUST BE SQUARE"
1170 RETURN
1200 REM PAGED MATRIX DISPLAY: DS,R,S,Q$
1210 PRINT Q$:CT=0
1220 FOR I=1 TO R:FOR J=1 TO S
1230 IF DS=1 THEN VV=A(I,J)
1240 IF DS=2 THEN VV=B(I,J)
1250 IF DS=3 THEN VV=C(I,J)
1260 IF DS=4 THEN VV=D(I,J)
1270 PRINT "(";I;",";J;")=";VV
1280 CT=CT+1
1290 IF CT=16 THEN GOSUB 1000:PRINT CHR$(147):PRINT Q$:CT=0
1300 NEXT J:NEXT I:RETURN
1400 DS=3:R=M:S=N:GOSUB 1200:RETURN
1450 FOR I=1 TO M:FOR J=1 TO N
1460 D(I,J)=A(I,J):NEXT J:NEXT I:RETURN
2000 REM INPUT A
2010 INPUT "ROWS,COLS FOR A (1-10)";R,S
2020 IF R<1 OR R>10 OR R<>INT(R) THEN 2010
2030 IF S<1 OR S>10 OR S<>INT(S) THEN 2010
2040 FOR I=1 TO R:FOR J=1 TO S
2050 PRINT "A(";I;",";J;")";:INPUT A(I,J)
2060 NEXT J:NEXT I:M=R:N=S
2070 PRINT "A STORED":RETURN
3000 REM INPUT B
3010 INPUT "ROWS,COLS FOR B (1-10)";R,S
3020 IF R<1 OR R>10 OR R<>INT(R) THEN 3010
3030 IF S<1 OR S>10 OR S<>INT(S) THEN 3010
3040 FOR I=1 TO R:FOR J=1 TO S
3050 PRINT "B(";I;",";J;")";:INPUT B(I,J)
3060 NEXT J:NEXT I:P=R:Q=S
3070 PRINT "B STORED":RETURN
4000 GOSUB 1100:IF GF=0 THEN RETURN
4010 DS=1:R=M:S=N:Q$="A =":GOSUB 1200:RETURN
5000 IF P=0 OR Q=0 THEN PRINT "B IS EMPTY":RETURN
5010 DS=2:R=P:S=Q:Q$="B =":GOSUB 1200:RETURN
6000 SG=1:Q$="A+B =":GOTO 6100
6100 IF M=0 OR N=0 OR P=0 OR Q=0 THEN PRINT "NEED BOTH MATRICES":RETURN
6110 IF M<>P OR N<>Q THEN PRINT "DIMENSIONS MUST MATCH":RETURN
6120 FOR I=1 TO M:FOR J=1 TO N
6130 C(I,J)=A(I,J)+SG*B(I,J)
6140 NEXT J:NEXT I:GOSUB 1400:RETURN
7000 SG=-1:Q$="A-B =":GOTO 6100
8000 IF M=0 OR N=0 OR P=0 OR Q=0 THEN PRINT "NEED BOTH MATRICES":RETURN
8010 IF N<>P THEN PRINT "A COLS MUST EQUAL B ROWS":RETURN
8020 FOR I=1 TO M:FOR J=1 TO Q:VV=0
8030 FOR K=1 TO N:VV=VV+A(I,K)*B(K,J):NEXT K
8040 C(I,J)=VV:NEXT J:NEXT I
8050 DS=3:R=M:S=Q:Q$="A*B =":GOSUB 1200:RETURN
9000 GOSUB 1100:IF GF=0 THEN RETURN
9010 FOR I=1 TO N:FOR J=1 TO M
9020 C(I,J)=A(J,I):NEXT J:NEXT I
9030 DS=3:R=N:S=M:Q$="TRANSPOSE(A) =":GOSUB 1200:RETURN
10000 INPUT "IDENTITY SIZE (1-10)";R
10010 IF R<1 OR R>10 OR R<>INT(R) THEN 10000
10020 S=R:FOR I=1 TO R:FOR J=1 TO R
10030 C(I,J)=-(I=J):NEXT J:NEXT I
10040 DS=3:Q$="IDENTITY =":GOSUB 1200:RETURN
11000 GOSUB 1150:IF GF=0 THEN RETURN
11010 IF M>3 THEN PRINT "DETERMINANT: SIZES 1,2,3 ONLY":RETURN
11020 IF M=1 THEN DD=A(1,1):GOTO 11100
11030 DD=A(1,1)*A(2,2)-A(1,2)*A(2,1)
11040 IF M=2 THEN 11100
11050 DD=A(1,1)*(A(2,2)*A(3,3)-A(2,3)*A(3,2))
11060 DD=DD-A(1,2)*(A(2,1)*A(3,3)-A(2,3)*A(3,1))
11070 DD=DD+A(1,3)*(A(2,1)*A(3,2)-A(2,2)*A(3,1))
11100 PRINT "DET(A) = ";DD:RETURN
12000 GOSUB 1100:IF GF=0 THEN RETURN
12010 INPUT "SCALAR";VV
12020 FOR I=1 TO M:FOR J=1 TO N
12030 C(I,J)=A(I,J)*VV:NEXT J:NEXT I
12040 Q$="SCALAR*A =":GOSUB 1400:RETURN
13000 GOSUB 1100:IF GF=0 THEN RETURN
13010 INPUT "TWO ROW NUMBERS";R1,R2
13020 IF R1<1 OR R1>M OR R1<>INT(R1) THEN 13010
13030 IF R2<1 OR R2>M OR R2<>INT(R2) THEN 13010
13040 FOR J=1 TO N:VV=A(R1,J)
13050 A(R1,J)=A(R2,J):A(R2,J)=VV:NEXT J
13060 GOSUB 4000:RETURN
14000 GOSUB 1100:IF GF=0 THEN RETURN
14010 INPUT "TWO COLUMN NUMBERS";R1,R2
14020 IF R1<1 OR R1>N OR R1<>INT(R1) THEN 14010
14030 IF R2<1 OR R2>N OR R2<>INT(R2) THEN 14010
14040 FOR I=1 TO M:VV=A(I,R1)
14050 A(I,R1)=A(I,R2):A(I,R2)=VV:NEXT I
14060 GOSUB 4000:RETURN
15000 GOSUB 1150:IF GF=0 THEN RETURN
15010 GOSUB 15500:NC=2*M:GOSUB 27000:IF GF=0 THEN RETURN
15020 FOR I=1 TO M:FOR J=1 TO M
15030 C(I,J)=D(I,J+M):NEXT J:NEXT I
15040 Q$="INVERSE(A) =":GOSUB 1400:RETURN
15500 REM BUILD AUGMENTED A,IDENTITY
15510 FOR I=1 TO M:FOR J=1 TO M
15520 D(I,J)=A(I,J):D(I,J+M)=-(I=J)
15530 NEXT J:NEXT I:RETURN
16000 GOSUB 1150:IF GF=0 THEN RETURN
16010 GOSUB 15500:NC=2*M:GOSUB 27000:IF GF=0 THEN RETURN
16020 DS=4:R=M:S=NC:Q$="GAUSS-JORDAN [I | INVERSE(A)]"
16030 GOSUB 1200:RETURN
17000 GOSUB 1150:IF GF=0 THEN RETURN
17010 IF P<>M OR Q<>1 THEN PRINT "B MUST BE AN M-ROW COLUMN VECTOR":RETURN
17020 GOSUB 1450
17030 FOR I=1 TO M:D(I,M+1)=B(I,1):NEXT I
17040 NC=M+1:GOSUB 27000:IF GF=0 THEN RETURN
17050 FOR I=1 TO M:C(I,1)=D(I,M+1):NEXT I
17060 DS=3:R=M:S=1:Q$="SOLUTION X =":GOSUB 1200:RETURN
18000 GOSUB 1150:IF GF=0 THEN RETURN
18010 INPUT "NONNEGATIVE INTEGER EXPONENT";EX
18020 IF EX<0 OR EX<>INT(EX) THEN 18010
18030 FOR I=1 TO M:FOR J=1 TO M
18040 C(I,J)=-(I=J):NEXT J:NEXT I
18050 IF EX=0 THEN 18200
18060 FOR K=1 TO EX:FOR I=1 TO M:FOR J=1 TO M:VV=0
18070 FOR L=1 TO M:VV=VV+C(I,L)*A(L,J):NEXT L
18080 D(I,J)=VV:NEXT J:NEXT I
18090 FOR I=1 TO M:FOR J=1 TO M
18100 C(I,J)=D(I,J):NEXT J:NEXT I:NEXT K
18200 Q$="MATRIX POWER =":GOSUB 1400:RETURN
19000 GOSUB 1100:IF GF=0 THEN RETURN
19010 FOR I=1 TO M:FOR J=1 TO N
19020 C(I,J)=A(I,J):NEXT J:NEXT I
19030 Q$="C = A =":GOSUB 1400:RETURN
20000 GOSUB 1100:IF GF=0 THEN RETURN
20010 GOSUB 1450:GOSUB 28000
20020 DS=4:R=M:S=N:Q$="RREF(A) =":GOSUB 1200:RETURN
21000 GOSUB 1150:IF GF=0 THEN RETURN
21010 VV=0:FOR I=1 TO M:VV=VV+A(I,I):NEXT I
21020 PRINT "TRACE(A) = ";VV:RETURN
22000 GOSUB 1100:IF GF=0 THEN RETURN
22010 GOSUB 1450:GOSUB 28000
22020 PRINT "RANK(A) = ";RC:RETURN
23000 REM CROUT LU: A=L*U, U HAS UNIT DIAGONAL
23010 GOSUB 1150:IF GF=0 THEN RETURN
23020 FOR I=1 TO M:FOR J=1 TO M
23030 C(I,J)=0:D(I,J)=0:NEXT J:NEXT I
23040 FOR J=1 TO M
23050 FOR I=J TO M:VV=0
23060 IF J=1 THEN 23090
23070 FOR K=1 TO J-1:VV=VV+C(I,K)*D(K,J):NEXT K
23090 C(I,J)=A(I,J)-VV:NEXT I
23100 IF C(J,J)=0 THEN PRINT "ZERO LU PIVOT - ROW PIVOTING NEEDED":RETURN
23110 D(J,J)=1:IF J=M THEN 23200
23120 FOR I=J+1 TO M:VV=0
23130 IF J=1 THEN 23160
23140 FOR K=1 TO J-1:VV=VV+C(J,K)*D(K,I):NEXT K
23160 D(J,I)=(A(J,I)-VV)/C(J,J):NEXT I
23200 NEXT J
23210 DS=3:R=M:S=M:Q$="L =":GOSUB 1200:GOSUB 1000
23220 DS=4:R=M:S=M:Q$="U (UNIT DIAGONAL) =":GOSUB 1200:RETURN
24000 GOSUB 1150:IF GF=0 THEN RETURN
24010 IF M<>2 THEN PRINT "THIS CHOICE NEEDS A 2X2 MATRIX":RETURN
24020 TR=A(1,1)+A(2,2):DD=A(1,1)*A(2,2)-A(1,2)*A(2,1)
24030 DX=TR*TR-4*DD
24040 IF DX<0 THEN 24100
24050 RR=SQR(DX):PRINT "LAMBDA1 = ";(TR+RR)/2
24060 PRINT "LAMBDA2 = ";(TR-RR)/2:RETURN
24100 RR=SQR(-DX)/2
24110 PRINT "LAMBDA1 = ";TR/2;" + ";RR;" I"
24120 PRINT "LAMBDA2 = ";TR/2;" - ";RR;" I":RETURN
25000 REM CUBIC EIGENVALUES: NORMALIZE TO LIMIT OVERFLOW
25010 GOSUB 1150:IF GF=0 THEN RETURN
25020 IF M<>3 THEN PRINT "THIS CHOICE NEEDS A 3X3 MATRIX":RETURN
25030 AM=0:FOR I=1 TO 3:FOR J=1 TO 3
25040 IF ABS(A(I,J))>AM THEN AM=ABS(A(I,J))
25050 NEXT J:NEXT I
25060 IF AM=0 THEN L1=0:L2=0:L3=0:GOTO 25900
25070 FOR I=1 TO 3:FOR J=1 TO 3
25080 D(I,J)=A(I,J)/AM:NEXT J:NEXT I
25090 TR=D(1,1)+D(2,2)+D(3,3)
25100 CF=D(1,1)*D(2,2)+D(1,1)*D(3,3)+D(2,2)*D(3,3)
25110 CF=CF-D(1,2)*D(2,1)-D(1,3)*D(3,1)-D(2,3)*D(3,2)
25120 DD=D(1,1)*(D(2,2)*D(3,3)-D(2,3)*D(3,2))
25130 DD=DD-D(1,2)*(D(2,1)*D(3,3)-D(2,3)*D(3,1))
25140 DD=DD+D(1,3)*(D(2,1)*D(3,2)-D(2,2)*D(3,1))
25150 PP=CF-TR*TR/3:QQ=-2*TR*TR*TR/27+TR*CF/3-DD
25160 DX=(QQ/2)^2+(PP/3)^3
25170 ET=1E-7*(ABS((QQ/2)^2)+ABS((PP/3)^3))
25180 IF ABS(DX)<=ET THEN DX=0
25190 IF DX<0 THEN 25500
25200 IF DX=0 THEN 25400
25210 XX=-QQ/2+SQR(DX):CU=SGN(XX)*ABS(XX)^(1/3)
25220 XX=-QQ/2-SQR(DX):CV=SGN(XX)*ABS(XX)^(1/3)
25230 L1=(CU+CV+TR/3)*AM
25240 L2=(-(CU+CV)/2+TR/3)*AM
25250 RR=SQR(3)/2*ABS(CU-CV)*AM
25260 PRINT "LAMBDA1 = ";L1
25270 PRINT "LAMBDA2 = ";L2;" + ";RR;" I"
25280 PRINT "LAMBDA3 = ";L2;" - ";RR;" I":RETURN
25400 XX=-QQ/2:CU=SGN(XX)*ABS(XX)^(1/3)
25410 L1=(2*CU+TR/3)*AM:L2=(-CU+TR/3)*AM:L3=L2
25420 GOTO 25900
25500 RR=SQR(-PP/3):XX=-QQ/(2*RR*RR*RR)
25510 IF XX>1 THEN XX=1
25520 IF XX<-1 THEN XX=-1
25530 IF XX=1 THEN TH=0:GOTO 25600
25540 IF XX=-1 THEN TH=ZP:GOTO 25600
25550 TH=ZP/2-ATN(XX/SQR(1-XX*XX))
25600 L1=(2*RR*COS(TH/3)+TR/3)*AM
25610 L2=(2*RR*COS((TH+2*ZP)/3)+TR/3)*AM
25620 L3=(2*RR*COS((TH+4*ZP)/3)+TR/3)*AM
25900 PRINT "LAMBDA1 = ";L1:PRINT "LAMBDA2 = ";L2
25910 PRINT "LAMBDA3 = ";L3:RETURN
27000 REM PARTIAL-PIVOT GAUSS-JORDAN, M BY NC
27010 GF=1
27020 FOR K=1 TO M:PS=K:BG=ABS(D(K,K))
27030 IF K=M THEN 27070
27040 FOR I=K+1 TO M
27050 IF ABS(D(I,K))>BG THEN BG=ABS(D(I,K)):PS=I
27060 NEXT I
27070 IF BG=0 THEN GF=0:PRINT "NO UNIQUE SOLUTION / SINGULAR":RETURN
27080 IF PS=K THEN 27120
27090 FOR J=1 TO NC:VV=D(K,J)
27100 D(K,J)=D(PS,J):D(PS,J)=VV:NEXT J
27120 PV=D(K,K):FOR J=K TO NC
27130 D(K,J)=D(K,J)/PV:NEXT J
27140 FOR I=1 TO M:IF I=K THEN 27180
27150 FC=D(I,K):FOR J=K TO NC
27160 D(I,J)=D(I,J)-FC*D(K,J):NEXT J
27170 D(I,K)=0
27180 NEXT I:NEXT K:RETURN
28000 REM RREF OF D: M BY N; RC RETURNS RANK
28010 RW=1:CL=1:RC=0:ET=0
28020 FOR I=1 TO M:FOR J=1 TO N
28030 IF ABS(D(I,J))>ET THEN ET=ABS(D(I,J))
28040 NEXT J:NEXT I:ET=ET*1E-8
28050 IF RW>M OR CL>N THEN RETURN
28060 PS=RW:BG=ABS(D(RW,CL))
28070 IF RW=M THEN 28110
28080 FOR I=RW+1 TO M
28090 IF ABS(D(I,CL))>BG THEN BG=ABS(D(I,CL)):PS=I
28100 NEXT I
28110 IF BG>ET THEN 28150
28120 FOR I=RW TO M:D(I,CL)=0:NEXT I
28130 CL=CL+1:GOTO 28050
28150 IF PS=RW THEN 28190
28160 FOR J=1 TO N:VV=D(RW,J)
28170 D(RW,J)=D(PS,J):D(PS,J)=VV:NEXT J
28190 PV=D(RW,CL):FOR J=CL TO N
28200 D(RW,J)=D(RW,J)/PV:NEXT J
28210 FOR I=1 TO M:IF I=RW THEN 28250
28220 FC=D(I,CL):FOR J=CL TO N
28230 D(I,J)=D(I,J)-FC*D(RW,J):NEXT J
28240 D(I,CL)=0
28250 NEXT I:RC=RC+1:RW=RW+1:CL=CL+1:GOTO 28050
