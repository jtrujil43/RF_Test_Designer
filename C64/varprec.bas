10 REM VARIABLE PRECISION - C64 BASIC V2
20 DIM A%(88),B%(88),R%(177)
30 PRINT CHR$(147);"VARIABLE-PRECISION INTEGER CALCULATOR"
40 PRINT "NONNEGATIVE INTEGERS: 1 TO 88 DIGITS"
50 PRINT "TYPE DIGITS. DEL EDITS. RETURN ACCEPTS."
60 PRINT:PRINT "FIRST INTEGER:"
70 GOSUB 1000:A$=Z$:LA=LEN(A$)
80 FOR I=1 TO LA
90 A%(LA-I+1)=ASC(MID$(A$,I,1))-48
100 NEXT I
110 PRINT:PRINT "SECOND INTEGER:"
120 GOSUB 1000:B$=Z$:LB=LEN(B$)
130 FOR I=1 TO LB
140 B%(LB-I+1)=ASC(MID$(B$,I,1))-48
150 NEXT I
160 PRINT:PRINT "A=ADD  M=MULTIPLY  Q=QUIT"
170 GET O$:IF O$="" THEN 170
180 IF O$="Q" THEN END
190 IF O$="A" THEN 230
200 IF O$="M" THEN 330
210 GOTO 170
230 N=LA:IF LB>N THEN N=LB
240 C=0
250 FOR I=1 TO N
260 V=A%(I)+B%(I)+C:C=INT(V/10):R%(I)=V-C*10
270 NEXT I
280 IF C>0 THEN R%(N+1)=C:N=N+1
290 GOTO 440
330 N=LA+LB
340 FOR I=1 TO N+1:R%(I)=0:NEXT I
350 FOR I=1 TO LA
360 FOR J=1 TO LB
370 R%(I+J-1)=R%(I+J-1)+A%(I)*B%(J)
380 NEXT J,I
390 FOR I=1 TO N
400 C=INT(R%(I)/10):R%(I)=R%(I)-C*10
410 R%(I+1)=R%(I+1)+C
420 NEXT I
430 IF R%(N+1)>0 THEN N=N+1
440 IF N>1 AND R%(N)=0 THEN N=N-1:GOTO 440
450 R$=""
460 FOR I=N TO 1 STEP -1
470 R$=R$+CHR$(R%(I)+48)
480 NEXT I
490 PRINT:PRINT "RESULT:":PRINT R$
500 GOTO 160
1000 REM GET BYPASSES THE 80-COLUMN INPUT LIMIT
1010 Z$=""
1020 GET K$:IF K$="" THEN 1020
1030 D=ASC(K$)
1040 IF D=13 AND LEN(Z$)>0 THEN PRINT:RETURN
1050 IF D<>20 THEN 1090
1060 IF LEN(Z$)=0 THEN 1020
1070 Z$=LEFT$(Z$,LEN(Z$)-1):PRINT CHR$(20);
1080 GOTO 1020
1090 IF D<48 OR D>57 OR LEN(Z$)=88 THEN 1020
1100 Z$=Z$+K$:PRINT K$;:GOTO 1020
