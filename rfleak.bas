1800 U=U*(20+G*G)/(10+G*G)+G*EXP(-G)
1810 GOSUB 1690:EV=EA
1820 U=W/H
1830 A0=.7287*(E1-(ER+1)/2)*(1-EXP(-.179*U))
1840 B0=.747*ER/(.15+ER)
1850 C1=B0-(B0-.207)*EXP(-.414*U)
1860 D0=.593+.694*EXP(-.562*U)
1870 OD=((ER+1)/2+A0-E1)*EXP(-C1*G^D0)+E1
1880 Q1=.8695*U^.194
1890 Q2=1+.7519*G+.189*G^2.31
1900 Q3=.1975+(16.6+(8.4/G)^6)^(-.387)
1910 Q3=Q3+LOG(G^10/(1+(G/3.4)^10))/241
1920 Q4=Q1/Q2*2/(EXP(-G)*U^Q3+(2-EXP(-G))*U^(-Q3))
1930 Q5=1.794+1.14*LOG(1+.638/(G+.517*G^2.43))
1940 Q6=.2305+LOG(G^10/(1+(G/5.8)^10))/281.3
1950 Q6=Q6+LOG(1+.598*G^1.154)/5.1
1960 Q7=(10+190*G*G)/(1+82.3*G^3)
1970 Q8=EXP(-6.5-.95*LOG(G)-(G/.15)^5)
1980 Q9=LOG(Q7)*(Q8+1/16.5)
1990 Q0=Q4-Q5/Q2*EXP(LOG(U)*Q6*U^(-Q9))
2000 ZE=Z1/(1-Z1*Q4/377)/SQR(EV)
2010 ZO=Z1/(1-Z1*Q0/377)/SQR(OD)
