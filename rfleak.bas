1510 IF T=0 THEN 1590
1520 TT=T/H
1530 HX=EXP(-2*SQR(6.517*U))
1540 HX=(1-HX)/(1+HX)
1550 DU=TT/PI*LOG(1+4*EXP(1)*HX*HX/TT)
1560 HX=SQR(ER-1)
