10 DIM A%(88),B%(88),R%(177)
20 PRINT "VARIABLE-PRECISION INTEGER CALCULATOR"
30 PRINT "ENTER NONNEGATIVE DECIMAL INTEGERS (UP TO 88 DIGITS)"
40 INPUT "FIRST INTEGER";A$
50 LA=LEN(A$):IF LA<1 OR LA>88 THEN PRINT "ENTER 1 TO 88 DIGITS":GOTO 40
60 FOR I=1 TO LA
70 D=ASC(MID$(A$,I,1)):IF D<48 OR D>57 THEN PRINT "DIGITS ONLY":GOTO 40
80 A%(LA-I+1)=D-48
90 NEXT I
100 INPUT "SECOND INTEGER";B$
110 LB=LEN(B$):IF LB<1 OR LB>88 THEN PRINT "ENTER 1 TO 88 DIGITS":GOTO 100
120 FOR I=1 TO LB
130 D=ASC(MID$(B$,I,1)):IF D<48 OR D>57 THEN PRINT "DIGITS ONLY":GOTO 100
140 B%(LB-I+1)=D-48
150 NEXT I
160 INPUT "ADD, MULTIPLY, OR QUIT (A/M/Q)";O$
170 IF O$="Q" THEN END
180 IF O$="A" THEN GOTO 220
190 IF O$="M" THEN GOTO 320
200 PRINT "ENTER A, M, OR Q":GOTO 160
220 N=LA:IF LB>N THEN N=LB
230 C=0
240 FOR I=1 TO N
250 V=A%(I)+B%(I)+C:C=INT(V/10):R%(I)=V-C*10
260 NEXT I
270 IF C>0 THEN R%(N+1)=C:N=N+1
280 GOTO 430
320 N=LA+LB
330 FOR I=1 TO N:R%(I)=0:NEXT I
340 FOR I=1 TO LA
350 FOR J=1 TO LB:R%(I+J-1)=R%(I+J-1)+A%(I)*B%(J):NEXT J
360 NEXT I
370 FOR I=1 TO N
380 C=INT(R%(I)/10):R%(I)=R%(I)-C*10:R%(I+1)=R%(I+1)+C
390 NEXT I
400 IF R%(N+1)>0 THEN N=N+1
430 IF N>1 AND R%(N)=0 THEN N=N-1:GOTO 430
440 R$=""
450 FOR I=N TO 1 STEP -1:R$=R$+CHR$(R%(I)+48):NEXT I
460 PRINT "RESULT: ";R$
470 GOTO 160
