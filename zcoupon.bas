1410 REM HAMMERSTAD JENSEN STATIC MICROSTRIP
1420 REM W,H,T IN UM; OUTPUT ZZ,EE
1430 U=W/H:DU=0:DR=0
1440 IF T=0 THEN 1520
1450 TT=T/H
1460 HX=EXP(-2*SQR(6.517*U))
1470 HX=(1-HX)/(1+HX)
1480 DU=TT/PI*LOG(1+4*EXP(1)*HX*HX/TT)
1490 HX=SQR(ER-1)
1500 HX=2/(EXP(HX)+EXP(-HX))
1510 DR=DU*(1+HX)/2
1520 U1=U+DU:U2=U+DR
1530 U=U1:GOSUB 1590:Z1=ZA
1540 U=U2:GOSUB 1590:Z2=ZA
1550 GOSUB 1620
1560 EE=EA*(Z1/Z2)^2
1570 ZZ=Z2/SQR(EA)
1580 RETURN
1590 ZA=6+(2*PI-6)*EXP(-(30.666/U)^.7528)
1600 ZA=376.7303137/(2*PI)*LOG(ZA/U+SQR(1+(2/U)^2))
1610 RETURN
1620 AA=1+LOG((U^4+(U/52)^2)/(U^4+.432))/49
1630 AA=AA+LOG(1+(U/18.1)^3)/18.7
1640 BB=.564*((ER-.9)/(ER+3))^.053
1650 EA=(ER+1)/2+(ER-1)/2*(1+10/U)^(-AA*BB)
1660 RETURN
1670 REM KIRSCHNING JANSEN STATIC; T=0
1680 REM W,H,SG UM; ZE,ZO,EV,OD OUTPUT
1690 U=W/H:G=SG/H
1700 Q$="COUPLED: W/H OR GAP/H"
1710 IF U<.1 OR U>10 OR G<.1 OR G>10 THEN 1200
1720 GOSUB 1590:Z1=ZA:GOSUB 1620:E1=EA
1730 U=U*(20+G*G)/(10+G*G)+G*EXP(-G)
1740 GOSUB 1620:EV=EA
1750 U=W/H
1760 A0=.7287*(E1-(ER+1)/2)*(1-EXP(-.179*U))
1770 B0=.747*ER/(.15+ER)
1780 C1=B0-(B0-.207)*EXP(-.414*U)
1790 D0=.593+.694*EXP(-.562*U)
1800 OD=((ER+1)/2+A0-E1)*EXP(-C1*G^D0)+E1
1810 Q1=.8695*U^.194
1820 Q2=1+.7519*G+.189*G^2.31
1830 Q3=.1975+(16.6+(8.4/G)^6)^(-.387)
1840 Q3=Q3+LOG(G^10/(1+(G/3.4)^10))/241
1850 Q4=Q1/Q2*2/(EXP(-G)*U^Q3+(2-EXP(-G))*U^(-Q3))
1860 Q5=1.794+1.14*LOG(1+.638/(G+.517*G^2.43))
1870 Q6=.2305+LOG(G^10/(1+(G/5.8)^10))/281.3
1880 Q6=Q6+LOG(1+.598*G^1.154)/5.1
1890 Q7=(10+190*G*G)/(1+82.3*G^3)
1900 Q8=EXP(-6.5-.95*LOG(G)-(G/.15)^5)
1910 Q9=LOG(Q7)*(Q8+1/16.5)
1920 Q0=Q4-Q5/Q2*EXP(LOG(U)*Q6*U^(-Q9))
1930 ZE=Z1/(1-Z1*Q4/377)/SQR(EV)
1940 ZO=Z1/(1-Z1*Q0/377)/SQR(OD)
1950 RETURN
1960 REM LOSSLESS LINE; ZM,EM,L MM,F GHZ,ZR
