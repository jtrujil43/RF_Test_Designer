8010 REM MICROSTRIP SYNTH: IN ER,H,T,TZ OUT W,EE,ZZ
8020 WL=.01*H:WH=100*H
8030 W=WL:GOSUB 8100:IF TZ>ZZ THEN 8090
8040 W=WH:GOSUB 8100:IF TZ<ZZ THEN 8090
8050 FOR IX=1 TO 30:W=(WL+WH)/2:GOSUB 8100
8060 IF ZZ>TZ THEN WL=W
8070 IF ZZ<=TZ THEN WH=W
8075 NEXT IX
8080 W=(WL+WH)/2:GOSUB 8100:RETURN
8090 PRINT "Z TARGET OUTSIDE WIDTH RANGE":END
8100 REM HAMMERSTAD JENSEN STATIC MICROSTRIP; W,H,T UM
8110 U=W/H:DU=0:DR=0
8120 IF T=0 THEN 8180
8130 TT=T/H:HX=EXP(-2*SQR(6.517*U)):HX=(1-HX)/(1+HX)
8140 DU=TT/PI*LOG(1+4*EXP(1)*HX*HX/TT)
8150 HX=SQR(ER-1):HX=2/(EXP(HX)+EXP(-HX))
8160 DR=DU*(1+HX)/2
8180 U1=U+DU:U2=U+DR
8182 U=U1:GOSUB 8200:Z1=ZA
8184 U=U2:GOSUB 8200:Z2=ZA
8186 GOSUB 8220:EE=EA*(Z1/Z2)^2:ZZ=Z2/SQR(EA):RETURN
8200 ZA=6+(2*PI-6)*EXP(-(30.666/U)^.7528)
8205 ZA=376.7303137/(2*PI)*LOG(ZA/U+SQR(1+(2/U)^2)):RETURN
8220 AA=1+LOG((U^4+(U/52)^2)/(U^4+.432))/49
8225 AA=AA+LOG(1+(U/18.1)^3)/18.7
8230 BB=.564*((ER-.9)/(ER+3))^.053
8235 EA=(ER+1)/2+(ER-1)/2*(1+10/U)^(-AA*BB):RETURN
