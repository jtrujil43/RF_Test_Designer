800 REM BARE ZIN AT F GHZ FROM LOAD, PAD C, VIA AND STUD LINES
810 R=RL:X=RX*F/FC:IF RX<0 THEN X=RX*FC/F
820 BC=2*PI*F*CP/1000:GOSUB 880
830 ZC=ZV:LL=VH/1000:GOSUB 850
840 ZC=ZS:LL=SH/1000:GOTO 850
850 PH=2*PI*F*LL*SQR(ER)/VC:CC=COS(PH):SS=SIN(PH)
860 NR=ZC*R*CC:NI=ZC*(X*CC+ZC*SS)
870 D1=ZC*CC-X*SS:D2=R*SS:DN=D1*D1+D2*D2
875 R=(NR*D1+NI*D2)/DN:X=(NI*D1-NR*D2)/DN:RETURN
880 DN=R*R+X*X:GG=R/DN:BQ=-X/DN+BC
885 DN=GG*GG+BQ*BQ:R=GG/DN:X=-BQ/DN:RETURN
900 AV=SQR(((R-ZR)^2+X*X)/((R+ZR)^2+X*X)):IF AV<.000001 THEN AV=.000001
910 DB=20*LOG(AV)/LOG(10):RETURN
