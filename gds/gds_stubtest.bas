8322 PRINT#1:QU=QZ+4:GOSUB 8310:QU=QR:GOTO 8310
8330 REM STRING RECORD QR,QS$ (EVEN PADDED)
8332 QL=LEN(QS$):QD=QL-INT(QL/2)*2:QZ=QL+QD:GOSUB 8320
8334 FOR QI=1 TO QL:QB=ASC(MID$(QS$,QI,1)):GOSUB 8300:NEXT QI
8336 IF QD=1 THEN QB=0:GOSUB 8300
8338 RETURN
8400 REM ELEMENT START QE 0 BOUNDARY 1 PATH, LY, QN POINTS, QW PATH WIDTH
8410 QR=2048+256*QE:QZ=0:GOSUB 8320
8420 QR=3330:QZ=2:GOSUB 8320:QU=LY:GOSUB 8310
8430 QR=3586:QZ=2:GOSUB 8320:QU=0:GOSUB 8310
8440 IF QE=0 THEN 8470
8450 QR=8450:QZ=2:GOSUB 8320:QU=0:GOSUB 8310
8460 QR=3843:QZ=4:GOSUB 8320:QV=INT(QW*1000+.5):GOSUB 8315
8470 QR=4099:QZ=8*QN:GOTO 8320
8480 REM POINT QX,QY UM AND BBOX
8481 QV=INT(QX*1000+.5):GOSUB 8315:QV=INT(QY*1000+.5):GOSUB 8315
8482 IF QX<Q1 THEN Q1=QX
8483 IF QY<Q2 THEN Q2=QY
8484 IF QX>Q3 THEN Q3=QX
8485 IF QY>Q4 THEN Q4=QY
8486 RETURN
8490 REM ENDEL
