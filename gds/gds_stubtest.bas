160 UQ=SW/H
170 DE=.412*H*(SE+.3)*(UQ+.264)/((SE-.258)*(UQ+.8))
180 SL=VC/(4*FC*SQR(SE))-DE/1000
190 IF SY=2 THEN SL=VC/(2*FC*SQR(SE))
200 IF SL<=0 THEN PRINT "STUB TOO SHORT":END
210 PRINT "STUB LENGTH MM ";SL;" NOTCH GHZ ";FC
220 PG=INT(1.1*SL*1000+800):LD=600:DD=FW:XC=LD/2+FL
230 GOSUB 8900
240 FOR J=1 TO 3
250 KF=.9+(J-1)*.1:RY=(2-J)*PG:SY$=MID$("ABC",J,1)
260 PA$=SY$+"-P1":PB$=SY$+"-P2":LT=10:GOSUB 9100
270 YS=RY-KF*SL*1000:LY=LP:GW=PW:GP=VP
280 G1=-XC:G3=XC:G2=RY+PP:G4=G2:GOSUB 8650
290 G1=-XC:G3=-PP:G2=RY-PP:G4=G2:GOSUB 8650
300 G1=PP:G3=XC:GOSUB 8650
310 YE=YS-PP:IF SY=2 THEN YE=YS
320 G1=-PP:G3=-PP:G2=RY-PP:G4=YE:GOSUB 8650
330 G1=PP:G3=PP:GOSUB 8650
340 IF SY=2 THEN G1=-PP:G3=PP:G2=YS:G4=YS:GOSUB 8650
350 R1=-SW/2:R3=SW/2:R2=YS:R4=RY:GOSUB 8500
360 LT=11:TX=-LD/2:TY=RY+PP+200
370 TS$=SY$+" STUB "+STR$(INT(KF*SL*1000+.5)/1000)+" MM":GOSUB 8700
380 PRINT SY$;" STUB MM ";KF*SL;" NOTCH GHZ ";FC/KF
390 NEXT J
400 GOSUB 8800:END
700 REM CUSTOM
710 INPUT "ER";ER:INPUT "H UM";H:INPUT "T UM";T:INPUT "Z0 OHM";ZR
720 INPUT "NOTCH FREQUENCY GHZ";FC
