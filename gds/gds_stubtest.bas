8660 IF GM=0 THEN 8664
8662 LY=GM:GOSUB 8500:LY=QK
8664 IF GV=0 THEN RETURN
8666 QG=ABS(G3-G1)+ABS(G4-G2):QG=INT(QG/GP+.5):IF QG<1 THEN QG=1
8668 FOR QJ=0 TO QG-1:QA=(QJ+.5)/QG:CX=G1+(G3-G1)*QA:CY=G2+(G4-G2)*QA:CR=VD/2
8670 LY=GV:GOSUB 8600
8672 IF GU>0 THEN LY=GU:GOSUB 8600
