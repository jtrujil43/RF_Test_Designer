8500 REM RECT R1,R2,R3,R4 ON LY
8510 IF R3<R1 THEN QT=R1:R1=R3:R3=QT
8520 IF R4<R2 THEN QT=R2:R2=R4:R4=QT
8530 QE=0:QN=5:GOSUB 8400
8540 QX=R1:QY=R2:GOSUB 8480:QX=R3:GOSUB 8480:QY=R4:GOSUB 8480
8545 QX=R1:GOSUB 8480:QY=R2:GOSUB 8480
8550 GOTO 8490
8600 REM CIRCLE CX,CY,CR NS SIDES ON LY
8610 QE=0:QN=NS+1:GOSUB 8400
8620 FOR QI=0 TO NS:QA=6.283185307*QI/NS:IF QI=NS THEN QA=0
8630 QX=CX+CR*COS(QA):QY=CY+CR*SIN(QA):GOSUB 8480:NEXT QI
8640 GOTO 8490
8650 REM GSEG RAIL G1,G2 TO G3,G4 WIDTH GW ON LY; VIAS GV,GU PITCH GP; GM UNDER
