20000 REM ---------- REDUCED ROW ECHELON FORM ----------
20010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
20020 FOR I = 1 TO M
20030 FOR J = 1 TO N
20040 D(I,J) = A(I,J)
20050 NEXT J
20060 NEXT I
20070 R = M
20080 C1 = N
20090 ROW = 1
20100 COL = 1
20110 FOR P = 1 TO M
20120 IF ROW > R THEN GOTO 20280
20130 IF COL > C1 THEN GOTO 20280
20140 BEST = ROW
20150 BIG = ABS(D(ROW,COL))
20160 FOR I = ROW + 1 TO R
20170 IF ABS(D(I,COL)) > BIG THEN BIG = ABS(D(I,COL)) : BEST = I
20180 NEXT I
20190 IF BIG = 0 THEN
20200 COL = COL + 1
20210 GOTO 20110
20220 END IF
20230 IF BEST <> ROW THEN
20240 FOR J = COL TO C1
20250 T = D(ROW,J)
20260 D(ROW,J) = D(BEST,J)
20270 D(BEST,J) = T
20280 NEXT J
20290 END IF
20300 PIV = D(ROW,COL)
20310 FOR J = COL TO C1
20320 D(ROW,J) = D(ROW,J) / PIV
20330 NEXT J
20340 FOR I = 1 TO R
20350 IF I <> ROW THEN
20360 FACT = D(I,COL)
20370 FOR J = COL TO C1
20380 D(I,J) = D(I,J) - FACT * D(ROW,J)
20390 NEXT J
20400 END IF
20410 NEXT I
20420 ROW = ROW + 1
20430 COL = COL + 1
20440 NEXT P
20450 PRINT "RREF(A) ="
20460 FOR I = 1 TO M
20470 FOR J = 1 TO N
20480 PRINT D(I,J);
20490 NEXT J
20500 PRINT
20510 NEXT I
20520 RETURN


