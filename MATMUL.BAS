23000 REM ---------- LU DECOMPOSITION ----------
23010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
23020 IF M <> N THEN PRINT "LU REQUIRES SQUARE MATRIX" : RETURN
23030 FOR I = 1 TO M
23040 FOR J = 1 TO M
23050 C(I,J) = 0
23060 D(I,J) = 0
23070 NEXT J
23080 NEXT I
23090 FOR I = 1 TO M
23100 C(I,1) = A(I,1)
23110 NEXT I
23120 FOR J = 2 TO M
23130 D(1,J) = A(1,J) / A(1,1)
23140 NEXT J
23150 FOR I = 2 TO M
23160 FOR J = 2 TO I
23170 S = 0
23180 FOR K = 1 TO J - 1
23190 S = S + C(I,K) * D(K,J)
23200 NEXT K
23210 C(I,J) = A(I,J) - S
23220 NEXT J
23230 FOR J = I + 1 TO M
23240 S = 0
23250 FOR K = 1 TO I - 1
23260 S = S + C(I,K) * D(K,J)
23270 NEXT K
23280 D(I,J) = (A(I,J) - S) / C(I,I)
23290 NEXT J
23300 NEXT I
23310 PRINT "L ="
23320 FOR I = 1 TO M
23330 FOR J = 1 TO M
23340 PRINT C(I,J);
23350 NEXT J
23360 PRINT
23370 NEXT I
23380 PRINT "U ="
23390 FOR I = 1 TO M
23400 FOR J = 1 TO M
23410 PRINT D(I,J);
23420 NEXT J
23430 PRINT
23440 NEXT I
23450 RETURN


24000 REM ---------- APPROXIMATE EIGENVALUES FOR 2X2 MATRIX ----------
24010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
24020 IF M <> N THEN PRINT "EIGENVALUES REQUIRE SQUARE MATRIX" : RETURN
24030 IF M <> 2 THEN PRINT "THIS VERSION SUPPORTS ONLY 2X2 MATRICES" : RETURN
24040 A11 = A(1,1)
24050 A12 = A(1,2)
24060 A21 = A(2,1)
24070 A22 = A(2,2)
24080 TR = A11 + A22
24090 DET = A11 * A22 - A12 * A21
24100 DIS = TR * TR - 4 * DET
24110 IF DIS < 0 THEN
24120 PRINT "EIGENVALUES ARE COMPLEX:"
24130 PRINT "LAMBDA1 = "; TR / 2;" + ";SQRT(-DIS)/2;"i"
24140 PRINT "LAMBDA2 = "; TR / 2;" - ";SQRT(-DIS)/2;"i"
24150 RETURN
24160 END IF
24170 ROOT = SQR(DIS)
24180 L1 = (TR + ROOT) / 2
24190 L2 = (TR - ROOT) / 2
24200 PRINT "LAMBDA1 = ";L1
24210 PRINT "LAMBDA2 = ";L2
24220 RETURN


25000 REM ---------- EIGENVALUES FOR 3X3 MATRIX ----------
25010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
25020 IF M <> N THEN PRINT "EIGENVALUES REQUIRE SQUARE MATRIX" : RETURN
25030 IF M <> 3 THEN PRINT "THIS ROUTINE SUPPORTS ONLY 3X3 MATRICES" : RETURN
25040 A11 = A(1,1)
25050 A12 = A(1,2)
25060 A13 = A(1,3)
25070 A21 = A(2,1)
25080 A22 = A(2,2)
25090 A23 = A(2,3)
25100 A31 = A(3,1)
25110 A32 = A(3,2)
25120 A33 = A(3,3)
25130 TR = A11 + A22 + A33
25140 C1 = A11*A22 + A11*A33 + A22*A33 - A12*A21 - A13*A31 - A23*A32
25150 C0 = A11*(A22*A33 - A23*A32) - A12*(A21*A33 - A23*A31) + A13*(A21*A32 - A22*A31)
25160 P = C1 - (TR*TR)/3
25170 Q = (2*TR*TR*TR)/27 - (TR*C1)/3 + C0
25180 DIS = (Q/2)*(Q/2) + (P/3)*(P/3)*(P/3)
25190 IF DIS > 0 THEN
25200 U = (-Q/2 + SQR(DIS))^(1/3)
25210 V = (-Q/2 - SQR(DIS))^(1/3)
25220 IF U < 0 THEN U = -(-U)^(1/3)
25230 IF V < 0 THEN V = -(-V)^(1/3)
25240 L1 = U + V - TR/3
25250 PRINT "ONE REAL ROOT:"
25260 PRINT "LAMBDA1 = ";L1
25270 RETURN
25280 END IF
25290 IF ABS(DIS) < 0.000001 THEN
25300 R1 = 2*(SQR(-P/3))
25310 L1 = R1 - TR/3
25320 L2 = -R1/2 - TR/3
25330 L3 = L2
25340 PRINT "MULTIPLE ROOTS:"
25350 PRINT "LAMBDA1 = ";L1
25360 PRINT "LAMBDA2 = ";L2
25370 PRINT "LAMBDA3 = ";L3
25380 RETURN
25390 END IF
25400 R = SQR(-(P/3))
25410 TH = ACOS(-(Q/(2*(R*R*R))))
25420 L1 = 2*R*COS(TH/3) - TR/3
25430 L2 = 2*R*COS((TH + 6.283185307)/3) - TR/3
25440 L3 = 2*R*COS((TH + 12.566370614)/3) - TR/3
25450 PRINT "LAMBDA1 = ";L1
25460 PRINT "LAMBDA2 = ";L2
25470 PRINT "LAMBDA3 = ";L3
25480 RETURN
