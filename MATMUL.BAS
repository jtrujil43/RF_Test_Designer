15000 REM ---------- INVERSE OF A VIA GAUSS-JORDAN ----------
15010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
15020 IF M <> N THEN PRINT "INVERSE REQUIRES SQUARE MATRIX" : RETURN
15030 FOR I = 1 TO M
15040 FOR J = 1 TO M
15050 D(I,J) = A(I,J)
15060 D(I,J+M) = 0
15070 NEXT J
15080 D(I,I+M) = 1
15090 NEXT I
15100 FOR K = 1 TO M
15110 BEST = K
15120 BIG = ABS(D(K,K))
15130 FOR I = K + 1 TO M
15140 IF ABS(D(I,K)) > BIG THEN BIG = ABS(D(I,K)) : BEST = I
15150 NEXT I
15160 IF BIG = 0 THEN PRINT "MATRIX IS SINGULAR" : RETURN
15170 IF BEST <> K THEN
15180 FOR J = K TO 2 * M
15190 T = D(K,J)
15200 D(K,J) = D(BEST,J)
15210 D(BEST,J) = T
15220 NEXT J
15230 END IF
15240 PIV = D(K,K)
15250 FOR J = K TO 2 * M
15260 D(K,J) = D(K,J) / PIV
15270 NEXT J
15280 FOR I = 1 TO M
15290 IF I <> K THEN
15300 FACT = D(I,K)
15310 FOR J = K TO 2 * M
15320 D(I,J) = D(I,J) - FACT * D(K,J)
15330 NEXT J
15340 END IF
15350 NEXT I
15360 NEXT K
15370 FOR I = 1 TO M
15380 FOR J = 1 TO M
15390 C(I,J) = D(I,J+M)
15400 NEXT J
15410 NEXT I
15420 PRINT "A^-1 ="
15430 FOR I = 1 TO M
15440 FOR J = 1 TO M
15450 PRINT C(I,J);
15460 NEXT J
15470 PRINT
15480 NEXT I
15490 RETURN

16000 REM ---------- GAUSS-JORDAN REDUCTION ----------
16010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
16020 IF M <> N THEN PRINT "GAUSS-JORDAN REQUIRES SQUARE MATRIX" : RETURN
16030 FOR I = 1 TO M
