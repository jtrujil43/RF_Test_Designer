17000 REM ---------- SOLVE AX = B ----------
17010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
17020 IF M <> N THEN PRINT "SOLVE REQUIRES SQUARE A" : RETURN
17030 IF P <> M THEN PRINT "B MUST HAVE SAME ROW COUNT AS A" : RETURN
17040 IF Q <> 1 THEN PRINT "B MUST BE A COLUMN VECTOR" : RETURN
17050 FOR I = 1 TO M
17060 FOR J = 1 TO M
17070 D(I,J) = A(I,J)
17080 NEXT J
17090 D(I,M+1) = B(I,1)
17100 NEXT I
17110 FOR K = 1 TO M
17120 BEST = K
17130 BIG = ABS(D(K,K))
17140 FOR I = K + 1 TO M
17150 IF ABS(D(I,K)) > BIG THEN BIG = ABS(D(I,K)) : BEST = I
17160 NEXT I
17170 IF BIG = 0 THEN PRINT "NO UNIQUE SOLUTION" : RETURN
17180 IF BEST <> K THEN
17190 FOR J = K TO M + 1
17200 T = D(K,J)
17210 D(K,J) = D(BEST,J)
17220 D(BEST,J) = T
17230 NEXT J
17240 END IF
17250 PIV = D(K,K)
17260 FOR J = K TO M + 1
17270 D(K,J) = D(K,J) / PIV
17280 NEXT J
17290 FOR I = 1 TO M
17300 IF I <> K THEN
17310 FACT = D(I,K)
17320 FOR J = K TO M + 1
17330 D(I,J) = D(I,J) - FACT * D(K,J)
17340 NEXT J
17350 END IF
17360 NEXT I
17370 NEXT K
17380 FOR I = 1 TO M
17390 V(I) = D(I,M+1)
17400 NEXT I
