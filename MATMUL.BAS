11000 REM ---------- DETERMINANT OF A ----------
11010 IF M = 0 OR N = 0 THEN PRINT "A IS EMPTY" : RETURN
11020 IF M <> N THEN PRINT "DETERMINANT REQUIRES SQUARE MATRIX" : RETURN
11030 IF M > 3 THEN PRINT "THIS VERSION SUPPORTS ONLY 1X1, 2X2, 3X3" : RETURN
11040 IF M = 1 THEN D1 = A(1,1) : GOTO 11120
11050 IF M = 2 THEN D1 = A(1,1) * A(2,2) - A(1,2) * A(2,1) : GOTO 11120
11060 D1 = A(1,1) * (A(2,2) * A(3,3) - A(2,3) * A(3,2))
11070 D1 = D1 - A(1,2) * (A(2,1) * A(3,3) - A(2,3) * A(3,1))
11080 D1 = D1 + A(1,3) * (A(2,1) * A(3,2) - A(2,2) * A(3,1))
11120 PRINT "DET(A) = ";D1
11130 RETURN

