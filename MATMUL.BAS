18180 NEXT J
18190 NEXT I
18200 FOR I = 1 TO M
18210 FOR J = 1 TO M
18220 C(I,J) = D(I,J)
18230 NEXT J
18240 NEXT I
18250 NEXT K
18260 PRINT "A^";E;" ="
